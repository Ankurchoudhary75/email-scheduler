generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  name             String?
  avatarUrl        String?
  googleId         String?    @unique
  slackAccessToken String?
  slackTeamId      String?
  slackChannel     String?
  slackWebhookUrl  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  emailJobs        EmailJob[]
}

model Sender {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  etherealUser String?
  etherealPass String?
  hourlyLimit  Int        @default(200)
  minDelayMs   Int        @default(2000)
  createdAt    DateTime   @default(now())
  emailJobs    EmailJob[]
}

model EmailJob {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId           String
  sender             Sender      @relation(fields: [senderId], references: [id])
  recipient          String
  subject            String
  body               String
  scheduledAt        DateTime
  sentAt             DateTime?
  status             EmailStatus @default(SCHEDULED)
  jobId              String?     @unique
  etherealPreviewUrl String?
  attempts           Int         @default(0)
  error              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model RateLimitLog {
  id         String   @id @default(uuid())
  senderId   String
  hourWindow String
  count      Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([senderId, hourWindow])
}
